package LaTeXML::Package::Pool;

use strict;
use warnings;

use URI;

Warn('unsupported', 'xr', undef, 'the package xr is not supported yet');

DefMacro('\externaldocument [] [] {} []', '\bml@externaldocument{#1}{#2}{#3}{#4}');
DefMacro('\bml@externaldocument Semiverbatim Semiverbatim Semiverbatim HyperVerbatim', '\bml@externaldocument@{#1}{#2}{#3}{#4}');

# see hyperref.sty.ltxml for the HyperVerbatim -> Semiverbatim sequence
DefConstructor('\bml@externaldocument@ Semiverbatim Semiverbatim Semiverbatim Semiverbatim', sub {
  my ($document, $prefix, $nocite, $doc, $url) = @_;
  ($prefix, $nocite, $url) = (ToString($prefix), ToString($nocite), ToString($url));
  $document->insertPI('xr', $prefix ? (prefix => $prefix) : (), $nocite ? (nocite => $nocite) : (), document => $doc, $url ? (url => URI->new($url)->as_string) : ());
});

Let('\externalcitedocument', '\externaldocument');

1;
