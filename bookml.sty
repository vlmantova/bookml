%%% Alternative formats
\iflatexml
  \ifbml@draft
    \let\bmlAltFormat\@gobbletwo
  \else
    \let\bml@alt@formats\@empty
    \let\bml@alt@formats@\@empty
    \newcommand{\bmlAltFormat}[2]{%
      \edef\@tempa{#1}%
      \expandafter\edef\csname bml@alt@format@label@\@tempa\endcsname{#2}%
      \edef\bml@alt@formats{\@tempa"\bml@alt@formats}}
    \def\bml@process@alt@formats#1"#2\relax{%
      \expandafter\ifx\csname bml@alt@format@label@#1\endcsname\@empty%
      \else%
        \edef\@tempa{[type={application/octet-stream;bmllocation=download;bmlname=\csname bml@alt@format@label@#1\endcsname}]}%
        \expandafter\let\csname bml@alt@format@label@#1\endcsname\@empty%
        \edef\bml@alt@formats@{\lxRequireResource\@tempa{#1}\bml@alt@formats@}%
      \fi%
      \def\@tempa{#2}%
      \ifx\@tempa\@empty%
      \else%
        \bml@process@alt@formats#2\relax%
      \fi}
    \AtBeginDocument{\expandafter\bml@process@alt@formats\bml@alt@formats\relax\bml@alt@formats@}
    \bmlAltFormat{\jobname.pdf}{PDF}
  \fi
\else
  \let\bmlAltFormat\@gobbletwo
\fi

