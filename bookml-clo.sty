  \let\small\undefined
  \let\footnotesize\undefined
  \let\scriptsize\undefined
  \let\tiny\undefined
  \let\large\undefined
  \let\Large\undefined
  \let\LARGE\undefined
  \let\huge\undefined
  \let\Huge\undefined

  \DeclareOption{8pt}{\def\@ptsize{8}}
  \DeclareOption{9pt}{\def\@ptsize{9}}
  \DeclareOption{10pt}{\def\@ptsize{10}}
  \DeclareOption{11pt}{\def\@ptsize{11}}
  \DeclareOption{12pt}{\def\@ptsize{12}}
  \DeclareOption{14pt}{\def\@ptsize{14}}
  \DeclareOption{17pt}{\def\@ptsize{17}}
  \DeclareOption{20pt}{\def\@ptsize{20}}

  \ExecuteOptions{10pt}

  \def\bml@clo@apply{\input{size\@ptsize.clo}}
}

