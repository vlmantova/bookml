# nocomments is not picked up from \RequirePackage is bookml.sty
RequirePackage('latexml', options => ['nocomments', 'noguesstabularheaders', 'dpi=96.36']) unless LookupDefinition(T_CS('\iflatexml'));

### BookML resources
DefPrimitiveI('\bml@resources', undef, sub {
    my $jobname = ToString(Expand(T_CS('\jobname')));
    my $style   = ToString(Expand(T_CS('\bml@style')));
    my @styles  = ('none', 'plain', 'gitbook');
    $style = $styles[$style];

    map { RequireResource($_) } bookml::resources::find($style, $jobname);

    return;
});

### BookML colors
# Compute colors for sepia and dark mode (mimicking CSS filters)
# note that xcolor.sty and LaTeXML::Common::Color use the linear RGB space
AtEndDocument(sub {
    return unless ToString(Expand(T_CS('\bml@style'))) eq '2';
    return T_CS('\bml@colors');
});

# CSS filter invert(100%) hue-rotate(180deg)
sub BMLColorDarkMode {
  my ($color) = @_;

  # sRGB to linear RGB
  my ($R, $G, $B) = $color->convert('rgb')->components;

  # invert
  # https://www.w3.org/TR/filter-effects-1/#invertEquivalent
  ($R, $G, $B) = map { 1 - $_ } ($R, $G, $B);

  # rotate hue
  # https://www.w3.org/TR/filter-effects-1/#element-attrdef-fecolormatrix-values
  ($R, $G, $B) = ((0.213 - 0.787) * $R + (0.715 + 0.715) * $G + (0.072 + 0.072) * $B,
    (0.213 + 0.213) * $R + (0.715 - 0.285) * $G + (0.072 + 0.072) * $B,
    (0.213 + 0.213) * $R + (0.715 + 0.715) * $G + (0.072 - 0.928) * $B);

  # clamp
  ($R, $G, $B) = map { ($_ < 0) ? 0 : (($_ > 1) ? 1 : $_) } ($R, $G, $B);
  return Color('rgb', $R, $G, $B);
}

# CSS filter sepia(40%)
sub BMLColorSepiaMode {
  my ($color) = @_;
  my $amount = 0.40;

  # sRGB to linear RGB
  my ($R, $G, $B) = $color->convert('rgb')->components;

  # sepia
  # https://www.w3.org/TR/filter-effects-1/#sepiaEquivalent
  ($R, $G, $B) = ((0.393 + 0.607 * (1 - $amount)) * $R + (0.769 - 0.769 * (1 - $amount)) * $G + (0.189 - 0.189 * (1 - $amount)) * $B,
    (0.349 - 0.349 * (1 - $amount)) * $R + (0.686 + 0.314 * (1 - $amount)) * $G + (0.168 - 0.168 * (1 - $amount)) * $B,
    (0.272 - 0.272 * (1 - $amount)) * $R + (0.534 - 0.534 * (1 - $amount)) * $G + (0.131 + 0.869 * (1 - $amount)) * $B);

  # clamp
  ($R, $G, $B) = map { ($_ < 0) ? 0 : (($_ > 1) ? 1 : $_) } ($R, $G, $B);
  return Color('rgb', $R, $G, $B);
}

my ($bml_colors_css, %bml_colors_darkmode, %bml_colors_sepiamode, %bml_colors) = ('', (), (), ());

DefConstructorI('\bml@colors', undef, sub {
    my ($document) = @_;

    ProgressSpinup('BookML colors');

    sub genColors {
      my ($attr, $color) = @_;
      my $color_hex;

      if (!ref $color) {    # hex string
        $color_hex = $color;
        my ($red, $green, $blue) = map { hex($_) / 255 } ($color_hex =~ m/../g);
        $color = Color('rgb', $red, $green, $blue); }
      else {                # LaTeXML::Common::Color
        $color_hex = substr($color->toHex, 1); }

      my $class = "bml_${attr}_$color_hex";
      $attr = "--bml-${attr}";

      if (!$bml_colors{$attr}{$color_hex}) {
        $bml_colors{$attr}{$color_hex} = 1;
        $bml_colors_darkmode{$color_hex}  //= BMLColorDarkMode($color)->toHex;
        $bml_colors_sepiamode{$color_hex} //= BMLColorSepiaMode($color)->toHex;
        my $dark_hex  = $bml_colors_darkmode{$color_hex};
        my $sepia_hex = $bml_colors_sepiamode{$color_hex};
        $bml_colors_css .= ".$class {$attr:#$color_hex !important} .book.color-theme-1 .$class {$attr:$sepia_hex !important} .book.color-theme-2 .$class {$attr:$dark_hex !important}\n"; }

      return $class;
    }

    # <ltx:text _font="...">
    for my $node ($document->findnodes('//*[@_font]')) {
      my $color = $document->getNodeFont($node)->getColor;
      $color = '000000' if $color eq 'black';    # $LaTeXML::Common::Font::DEFCOLOR
      my $class   = genColors('color', $color);
      my $bgcolor = $document->getNodeFont($node)->getBackground;
      $class .= ' ' . genColors('background-color', $bgcolor) if defined $bgcolor; }

    # <ltx:* framecolor="...">
    for my $node ($document->findnodes('//*[@framecolor]')) {
      my $color_hex = substr($node->getAttribute('framecolor'), 1);
      my $class     = genColors('border-color', $color_hex);
      $document->addClass($node, $class); }

    # <ltx:* backgroundcolor="...">
    for my $node ($document->findnodes('//*[@backgroundcolor]')) {
      my $color_hex = substr($node->getAttribute('backgroundcolor'), 1);
      my $class     = genColors('background-color', $color_hex);
      $document->addClass($node, $class); }

    # <ltx:rule color="...">
    for my $node ($document->findnodes('//ltx:rule[@color]')) {
      my $color_hex = substr($node->getAttribute('color'), 1);
      my $class     = genColors('background-color', $color_hex);
      $document->addClass($node, $class); }

    for my $attr ('color', 'fill', 'stroke', 'stop-color', 'flood-color', 'lighting-color') {
      for my $node ($document->findnodes("//*[\@$attr and not(self::ltx:rule)]")) {
        my $color_hex = $node->getAttribute($attr);
        next if $color_hex =~ m/^(none|context-fill|context-stroke)$|^url\(/;    # see SVG <paint> values
        $color_hex = '#000000' if $color_hex eq 'black';    # $LaTeXML::Common::Font::DEFCOLOR
        $color_hex = substr($color_hex, 1);
        my $class = genColors($attr, $color_hex);
        $document->addClass($node, $class); } }

    # <ltx:* cssstyle="... text-decoration-color:...">
    for my $node ($document->findnodes('//*[contains(@cssstyle,"text-decoration-color:")]')) {
      my ($color_hex) = $node->getAttribute('cssstyle') =~ m/text-decoration-color: *#([0-9A-Fa-f])*/;
      my $class = genColors('text-decoration-color', $color_hex);
      $document->addClass($node, $class); }

    if ($bml_colors_css) {
      (mkdir("bmluser") or die "cannot create directory bmluser: $!") unless -d "bmluser";
      my $jobname = ToString(Expand(T_CS('\jobname')));
      my $cssfile = "bmluser/colors.gitbook-$jobname.css";
      open(my $fh, '>', $cssfile) or die "cannot write to $cssfile: $!";
      print $fh $bml_colors_css;
      close($fh); }

    ProgressSpindown('BookML colors');
    return;
});

### Minimal HTML5 parser
# Deviations from spec:
# - only XML entities are decoded
# - ambiguous & allowed in attributes
# - final / closes all elements, including non-void, unless part of attribute
# - limited error checking
sub decodeHTMLEntities {
  my ($str) = @_;

  $str =~ s/&lt;/</g;
  $str =~ s/&gt;/>/g;
  $str =~ s/&apos;/'/g;
  $str =~ s/&quot;/"/g;

  while ($str =~ m/&#([^;]+);/) {
    my $num = $1;
    my $char;

    if ($num =~ /^\d+$/) {
      $char = chr($1);
    } elsif ($num =~ /^(?:x|X)([0-9a-fA-F]+)$/) {
      $char = chr(hex($1));
    } else {
      # invalid reference, deactivate & (it will be decoded at the end)
      $char = "&amp;#$num;";
    }

    # keep & encoded (it will be decoded at the end)
    $char = '&amp;' if $char eq '&';

    $str =~ s/&#\Q$num\E;/$char/g;
  }

  # encode & for unterminated references (it will be decoded at the end)
  $str =~ s/&#/&amp;#/g;

  $str =~ s/&amp;/&/g;

  return $str;
}

sub parseHTMLAfterElem {
  my ($where, $rawtag) = @_;
  my %parsed = (selfclose => 0, attrs => {});

  my $state = 3;
  my $name  = '';
  my $value = '';

  my $ws = qr/ \n\f\r/;

  # states like bookml.sty.rhai, simplified
  # 3/4/5. after attribute/attribute name/'='
  while ($rawtag) {
    $_ = $state . substr($rawtag, 0, 1);
    if    (m!.[$ws]!) { $rawtag =~ s!^[$ws]*!!; }    # skip whitespace
    elsif (m![34]/!) {
      $rawtag =~ s!^/!!;
      if ($rawtag) {
        Error('malformed', $rawtag, $where, 'skipping invalid character \'/\' in attribute list'); }
      else {
        $parsed{selfclose} = 1; } }
    elsif (m!4=!) { $rawtag =~ s!^=!!; $state = 5; }
    elsif (m!^5('|"|)!) {
      my $delim = $1;
      if ($delim) {
        $rawtag =~ s!^$delim([^$delim]*)(?:$delim|$)!!;
        $value = $1; }
      else {
        $rawtag =~ s!^([^$ws]*)!!;
        $value = $1; }
      if ($name) {
        $parsed{attrs}->{$name} = decodeHTMLEntities($value);
        $name = ''; }
      else {
        Error('malformed', "=$delim$value$delim", $where, 'skipping HTML attribute without name'); }
      $value = '';
      $state = 3; }
    else {
      $parsed{attrs}->{$name} = '' if m!^4! && $name;
      $rawtag =~ s!^([^=$ws/]*)!!;
      $name  = $1;
      $state = 4; }
  }

  $parsed{attrs}->{$name} = $value if $name;

  return %parsed;
}

### Inline HTML tags via enviroments
# \begin{h:TAG}[attr1=value,attr2] ... \end{h:TAG}
DefPrimitive('\bml@html@setinline Expanded Expanded', sub {
    my ($stomach, $tag, $inline) = @_;
    AssignMapping('bml@html@inline', ToString($tag) => ToString($inline));
});

DefEnvironment('{bml@html@env@} Undigested',
  '?#inline
    (<ltx:xmlinlineelem name="#elem" ns="http://www.w3.org/1999/xhtml">#body</ltx:xmlinlineelem>)
    (<ltx:xmlelem name="#elem" ns="http://www.w3.org/1999/xhtml">#body</ltx:xmlelem>)',
  ($LaTeXML::VERSION > v0.8.8) ? (afterDigestBegin => sub {
      my ($stomach, $whatsit) = @_;
      $whatsit->getProperty('inline') ? $stomach->enterHorizontal : $stomach->leaveHorizontal; }) : (),
  properties => sub {
    my ($stomach, $elem) = @_;
    $elem = lc(ToString($elem));
    return (elem => $elem, inline => LookupMapping('bml@html@inline', $elem));
  },
  reversion => ''
);

DefConstructor('\bml@html@attr@ Undigested Undigested',
  '?#1(<ltx:xmlattr name="#1" value="#value"/>)',
  properties => sub {
    my ($stomach, $name, $value) = @_;
    return (value => decodeHTMLEntities(ToString($value)));
  },
  reversion => ''
);

### Inline HTML tags via \<
# \<TAG attr1="value" attr>
DefConstructor('\bml@html@tag Undigested', sub {
    my ($document, $rawtag, %props) = @_;
    my $close  = $props{'close'};
    my $elem   = $props{'elem'};
    my $inline = $props{'inline'};
    my $qname  = "ltx:xml${inline}elem";

    if (!$close) {
      my %parsed = parseHTMLAfterElem($document, $props{'afterElem'});

      $document->openElement($qname, name => $elem, ns => 'http://www.w3.org/1999/xhtml');

      for my $a (keys %{ $parsed{attrs} }) {
        my $attr = $document->insertElement('ltx:xmlattr', undef, name => $a);
        $attr->setAttribute('value', $parsed{attrs}->{$a}); }

      $document->closeElement($qname) if $parsed{selfclose};
    } else {
      $document->closeElement($qname);
    }
  },
  ($LaTeXML::VERSION > v0.8.8) ? (afterDigest => sub {
      my ($stomach, $whatsit) = @_;
      if (!$whatsit->getProperty('close')) {
        $whatsit->getProperty('inline') ? $stomach->enterHorizontal : $stomach->leaveHorizontal; }}) : (),
  properties => sub {
    my ($stomach, $rawtag) = @_;
    my %props = ();

    if (ToString($rawtag) =~ m!^(/?)([^ \n\f\r/]*)(.*)$!) {
      my ($close, $elem, $afterElem) = ($1, lc($2), $3);
      # TeX uses carriage return to represent newlines
      $afterElem =~ s/\r/\n/g;

      my $inline = LookupMapping('bml@html@inline', $elem) // '';

      return (
        afterElem => $afterElem,
        close     => $close,
        elem      => $elem,
        inline    => $inline
      );
    } else {
      return ();
    }
  },
  reversion => ''
);

### Inline HTML via \bmlRawHTML
my $parser = XML::LibXML->new();

DefConstructor('\bml@html@raw@ Undigested', sub {
    my ($document, $rawhtml, %options) = @_;
    # TeX uses carriage return to represent newlines
    $rawhtml = ToString($rawhtml);
    $rawhtml =~ s/\r/\n/g;

    my $nodes = $parser->parse_balanced_chunk("<div xmlns='http://www.w3.org/1999/xhtml'>$rawhtml</div>");

    if ($nodes) {
      my $inPreamble = $options{inPreamble};
      my $qname      = $inPreamble ? "ltx:resource" : "ltx:rawhtml";

      my $node = $document->openElement($qname, ($inPreamble ? (type => 'application/xhtml+xml') : ()));

      map { $document->appendClone($node, $_) } $nodes->firstChild->findnodes('node()');
      $document->closeElement($qname);
    }
  },
  properties => sub {
    return (inPreamble => LookupValue('inPreamble'));
  },
  reversion => ''
);

### Image generation via LaTeX
# \begin{bmlimage} ... \end{bmlimage}
# \bmlImageEnvironment{tikzpicture}
DefPrimitive('\bml@image@generate', sub {
    my $jobname = ToString(Expand(T_CS('\jobname')));
    my $source  = LookupValue('SOURCEFILE');
    my $imagescale = ToString(Expand(T_CS('\bml@image@scale')));

    if ($imagescale !~ m/^(?:\d+|\d*\.\d+)$/) {
      Error('malformed', 'imagescale', undef, "ignoring non-decimal value '$imagescale' for option imagescale of bookml.sty");
      DefMacroI('\bml@image@scale', undef, 1);
      $imagescale = 1; }

    ProgressSpinup('BookML images');

    my @depths = bookml::bmlimages::generate($source, $jobname, $imagescale);

    for (@depths) {
      if (m/^(\d+):.*:.*:(\d+(?:\.\d+)?)/) {
        AssignMapping('bml@image@depth', $1, $2);
      }
    }

    ProgressSpindown('BookML images');
    return;
});

DefConstructor('\bml@image@depth{}', sub {
    my ($document, $counter, %props) = @_;
    my $depth = LookupMapping('bml@image@depth', ToString($counter));

    if ($depth) {
      my $node = $document->getLastChildElement($document->getElement);
      my $imagescale = $props{imagescale} || 1;

      $document->setAttribute($node, 'imagedepth', int((0.5 + $depth) * $imagescale * 96 / 72)); }
    return;
  },
  properties => sub {
    return (imagescale => ToString(Expand(T_CS('\bml@image@scale'))));
  }
);

### Alternative text
DefConstructor('\bmlDescription Semiverbatim', sub {
    my ($document, $text) = @_;
    my $node = $document->getLastChildElement($document->getElement);
    $document->setAttribute($node, 'description', ToString($text));
  },
  reversion => ''
);

### Add class to previous node
DefConstructor('\bmlPlusClass Semiverbatim', sub {
    my ($document, $class) = @_;
    my $curr = $document->getElement;
    my $node = $document->findnode("*[last()]", $curr);
    $document->addClass($node, ToString($class)) if $node;
  },
  reversion => ''
);

### Disable MathJax locally
DefConstructor('\bmlDisableMathJax', sub {
    my ($document) = @_;
    my $elem       = $document->getElement;
    my $eqelem     = $document->findnode('ancestor-or-self::ltx:equation[1]//ltx:Math', $elem);

    if ($eqelem) {
      $document->addClass($eqelem, 'bml_disable_mathjax'); }
  },
  reversion => ''
);

### Unicode variation sequences
DefMathI('\emptyset', undef, "\x{2205}\x{FE00}", role => 'ID', meaning => 'empty-set');

### LaTeXML bugfixes and improvements
{

  ### Copy HyperVerbatim from v0.9 to support xr

  if ($LaTeXML::VERSION <= v0.8.8) {
    DefParameterType('HyperVerbatim', sub {
        my ($gullet) = @_;
        $gullet->readUntil(T_BEGIN);
        StartSemiverbatim('%');
        DefMacroI('\%',              undef, T_OTHER('%'), scope => 'local');
        DefMacroI('\#',              undef, T_OTHER('#'), scope => 'local');
        DefMacroI('\&',              undef, T_OTHER('&'), scope => 'local');
        DefMacroI('\textunderscore', undef, T_OTHER('_'), scope => 'local');
        Let('\_', '\textunderscore');
        DefMacroI('\hyper@tilde', undef, T_OTHER('~'), scope => 'local');
        Let('\~',              '\hyper@tilde');
        Let('\textasciitilde', '\hyper@tilde');
        Let('\\\\',            '\@backslashchar');
        my $arg = $gullet->readBalanced(1);
        EndSemiverbatim();
        return $arg; },
      beforeDigest => sub {
        $_[0]->bgroup;
        MergeFont(family => 'typewriter'); },
      afterDigest => sub {
        $_[0]->egroup; },
      reversion => sub { (T_BEGIN, Revert($_[0]), T_END); });
  }
  ### Rules

  if ($LaTeXML::VERSION <= v0.8.8) {
    my $relativize = sub {
      my ($document, $whatsit) = @_;
      my ($w, $h, $d) = map { $whatsit->getProperty($_); } ('rwidth', 'cheight', 'rdepth');
      my $em = $STATE->lookupValue('font')->getEMWidth;
      ($w, $h, $d) = map { defined $_ && $_ !~ /%$/ ? roundto(Dimension($_)->spValue / $em, 2) . 'em' : $_; } ($w, $h, $d);
      $whatsit->setProperty('rwidth',  $w) if defined $w;
      $whatsit->setProperty('rheight', $h) if defined $h;
      $whatsit->setProperty('rdepth',  $d) if defined $d;
    };

    my $hrule = LookupDefinition(T_CS('\hrule'));
    my $vrule = LookupDefinition(T_CS('\vrule'));
    my $rule  = LookupDefinition(T_CS('\rule'));

    # relativise the rule sizes
    push(@{ $$hrule{beforeConstruct} }, $relativize);
    push(@{ $$vrule{beforeConstruct} }, $relativize);
    push(@{ $$rule{beforeConstruct} }, sub {
        my ($document, $whatsit) = @_;
        my ($w, $h, $d) = map { $whatsit->getProperty($_); } ('width', 'height', 'offset');
        my $em = $STATE->lookupValue('font')->getEMWidth;
        ($w, $h, $d) = map { defined $_ && $_ !~ /%$/ ? roundto(Dimension($_)->spValue / $em, 2) . 'em' : $_; } ($w, $h, $d);
        $whatsit->setProperty('width',  $w) if defined $w;
        $whatsit->setProperty('height', $h) if defined $h;
        $whatsit->setProperty('offset', $d) if defined $d;
    });

    # add CSS classes
    push(@{ $$hrule{afterConstruct} }, sub {
        my ($document, $whatsit) = @_;
        if (!$whatsit->getProperty('isHorizontal') && !inSVG()) {
          my $node = $document->getLastChildElement($document->getElement);
          $document->addClass($node, 'bml_hrule'); }
    });

    push(@{ $$vrule{afterConstruct} }, sub {
        my ($document, $whatsit) = @_;
        if (!$whatsit->getProperty('invisible') && !$whatsit->getProperty('isVertical') && !inSVG()) {
          my $node = $document->getLastChildElement($document->getElement);
          $document->addClass($node, 'bml_vrule'); }
    });

    # \hrule switches to vertical mode: close the parent ltx:p element, unconditionally
    push(@{ $$hrule{beforeConstruct} }, sub {
        # not perfect yet: the paragraph after \hrule is intended, meaning it should start a new ltx:para
        $_[0]->floatToElement('ltx:block') unless inSVG;
    });

    # \vrule switches to horizontal mode: open an inline context (see \hbox for reference)
    push(@{ $$vrule{beforeConstruct} }, sub {
        my ($document) = @_;
        if (!inSVG) {
          my $node = $document->getElement;
          $document->openElement('ltx:p') if !$document->canContain($node, '#PCDATA'); }
    });

    AtBeginDocument(sub {
        DefConstructor('\lx@algo@rule', "<ltx:rule class='bml_vrule bml_algo_rule' />") if LookupDefinition(T_CS('\lx@algo@rule'));
        return;
    });
  }

  ### Framed boxes

  if ($LaTeXML::VERSION <= v0.8.8) {
    my $framebox = LookupDefinition(T_CS('\@framebox'));
    push(@{ $$framebox{afterConstruct} }, sub {
        my ($document) = @_;
        my $node = $document->getNode->lastChild;
        $document->addClass($node, 'bml_framebox');
        return;
    });
  }

  AtBeginDocument(sub {
      if ($LaTeXML::VERSION <= v0.8.8 && (my $boxedtext = LookupDefinition(T_CS('\boxed@text')))) {
        $$boxedtext{properties} = sub {
          my $sep = LookupRegister('\fboxsep')->toAttribute;
          (framecolor => LookupValue('font')->getColor,
            ($sep ne '3.0pt' ? (cssstyle => 'padding:' . $sep) : ()));
        };

        push(@{ $$boxedtext{afterConstruct} }, sub {
            my ($document, $whatsit) = @_;
            my $node = $document->getNode->lastChild;
            $document->addClass('bml_framebox');
            $document->setAttribute('framecolor', $whatsit->getProperty('framecolor'));
            $document->setAttribute('cssstyle',   $whatsit->getProperty('cssstyle'));
            return;
        });
      }

      if ($LaTeXML::VERSION <= v0.8.8 && (my $fcolorbox = LookupDefinition(T_CS('\fcolorbox')))) {
        $$fcolorbox{properties} = sub {
          my $sep = LookupRegister('\fboxsep')->toAttribute;
          $sep ne '3.0pt' ? (cssstyle => 'padding:' . $sep) : ();
        };

        push(@{ $$fcolorbox{afterConstruct} }, sub {
            my ($document, $whatsit) = @_;
            my $node = $document->getNode->lastChild;
            $document->addClass('bml_framebox');
            $document->setAttribute('cssstyle', $whatsit->getProperty('cssstyle'));
            return;
        });
      }

      if ($LaTeXML::VERSION <= v0.8.8 && (my $lstframe = LookupDefinition(T_CS('\lst@@@set@frame')))) {
        push(@{ $$lstframe{beforeConstruct} }, sub {
            my ($document, $whatsit) = @_;
            if ($document->getNodeQName($document->getElement) eq 'ltx:text') {
              $whatsit->setProperty(frame => ''); }
        });
      }

      if ($LaTeXML::VERSION <= v0.8.8 && (my $beginAlignment = LookupDefinition(T_CS('\@start@alignment')))) {
        push(@{ $$beginAlignment{afterConstruct} }, sub {
            my ($document, $whatsit) = @_;
            my $alignment = $whatsit->getProperty('alignment');
            my $name      = ToString($$alignment{properties}{attributes}{name});
            if ($name) {
              my $node = $document->getLastChildElement($document->getElement);
              $document->addClass($node, "bml_alignment_$name"); }
        });
      }

      # amsmath fixes
      # - semantically correct \hdotsfor
      # - add an empty identifiers to get the correct spacing of +, - starting an equation
      # - fix multline alignment
      if ($LaTeXML::VERSION <= v0.8.8 && LookupValue('amsmath.sty.ltxml_loaded')) {
        DefMacro('\hdotsfor[]{Number}', sub {
            my $cols = $_[2]->valueOf;
            $cols = 1 if $cols < 1;
            (map { T_CS('\hdots'), T_ALIGN } 1 .. $cols - 1), T_CS('\hdots'); });

        # empty identifier, followed by clean up routine to minimize the chances of spurious invisible times
        DefConstructor('\@bml@ams@absent', '<ltx:XMTok meaning="absent" xml:id="#id"/>',
          properties => sub {
            my ($stomach, $whatsit) = @_;
            my $cnt = LookupValue('BML_AMS_ABSENT_IDEN') // 0;
            AssignValue('BML_AMS_ABSENT_IDEN' => ++$cnt, 'global');
            DefMacroI('\@bml@ams@absent@iden', undef, $cnt);
            return (id => "bml-ams-absent-iden-$cnt"); },
          reversion => '{}', alias => '');
        DefConstructorI('\@bml@ams@absent@cleanup', undef, '', reversion => '',
          properties => sub {
            my ($stomach, $whatsit) = @_;
            my $cnt = ToString(Expand(T_CS('\@bml@ams@absent@iden')));
            return (id => "bml-ams-absent-iden-$cnt"); },
          beforeConstruct => sub {
            my ($document, $whatsit) = @_;
            my $id = $whatsit->getProperty('id') or return;
            my $absent = $document->getDocument->getElementById($id);
            if (!$absent) {
              Warn('expected', 'absent', $document, 'could not find the auto-inserted empty identifier');
              return; }
            $absent->removeAttribute('xml:id');
            my $node = $absent->nextNonBlankSibling;
            if ($node) {
              my $role = $node->getAttribute('role');
              if (!defined $role) {
                my $tag = $document->getModel->getNodeQName($node);
                # TODO resolve XMRef (is it possible at this stage?)
                if ($tag eq 'ltx:XMDual') {
                  my ($content, $presentation) = element_nodes($node);
                  $role = $content->getAttribute('role') || $presentation->getAttribute('role') || ''; } }
              $role = '' unless $role;
              # remove the empty identifier if it is not followed by a possible binary operator
              if (!grep { $role eq $_ } ('VERTBAR', 'RELOP', 'ARROW', 'METARELOP', 'MODIFIEROP', 'ADDOP', 'MULOP', 'BINOP', 'APPLYOP', 'COMPOSEOP')) {
                $document->replaceNode($absent, ()); } }
          });

        # identical to LaTeXML except for the addition of the empty identifier + cleanup
        DefPrimitive('\@ams@align@bindings', sub {
            my $col1 = { before => Tokens(T_CS('\hfil'), T_MATH, T_CS('\displaystyle')),
              after => Tokens(T_MATH) };
            my $col2 = { before => Tokens(T_MATH, T_CS('\displaystyle'), T_CS('\@bml@ams@absent')),
              after => Tokens(T_CS('\@bml@ams@absent@cleanup'), T_MATH, T_CS('\hfil')) };
            amsRearrangeableBindings(LaTeXML::Core::Alignment::Template->new(repeated => [$col1, $col2]),
              attributes => { class => 'ltx_eqn_align', colsep => '0pt' });
        });
        DefPrimitive('\@ams@aligned@bindings', sub {
            my $col1 = { before => Tokens(T_CS('\hfil'),
                T_CS('\displaystyle')) };
            my $col2 = { before => Tokens(T_CS('\displaystyle'), T_CS('\@bml@ams@absent')),
              after => Tokens(T_CS('\@bml@ams@absent@cleanup'), T_CS('\hfil')) };
            my $template = LaTeXML::Core::Alignment::Template->new(repeated => [$col1, $col2]);
            amsAlignmentBindings($template, (name => 'aligned', colsep => '0pt'));
            DefMacro('\lx@alignment@row@before', '');
            DefMacro('\lx@alignment@row@after',  '');
            return; });
        DefPrimitiveI('\@ams@multirow@bindings', 'RequiredKeyVals:multirow OptionalKeyVals', sub {
            my ($stomach, $attributes, $options) = @_;
            my %attr    = $attributes->getPairs;
            my %options = ($options ? $options->getPairs : ());
            if (my $va = $attr{vattach}) {
              $attr{vattach} = translateAttachment($va) || ToString($va); }
            if ($attr{width} && $attr{width}->valueOf == 0) {
              delete $attr{width}; }
            my $before = $options{before_row};
            my $after  = $options{after_row};
            my $col1   = {
              before => Tokens(T_CS('\hfil'), T_CS('\displaystyle'), T_CS('\@bml@ams@absent'),
                ($before ? (T_CS('\text'), T_BEGIN, $before, T_END) : ())),
              after => Tokens(($after ? (T_CS('\text'), T_BEGIN, $after, T_END) : ()), T_CS('\@bml@ams@absent@cleanup')) };
            my $template = LaTeXML::Core::Alignment::Template->new(repeated => [$col1]);
            amsAlignmentBindings($template, %attr);
            return; });

        # patch multline to center middle entries, right align if there is a single row
        # use environment to enable implementation of \shoveleft, \shoveright
        foreach my $multline (LookupDefinition(T_CS('\@@multline')), LookupDefinition(T_CS('\@@multlinestar')), LookupDefinition(T_CS('\@@AmS@multline'))) {
          unshift(@{ $$multline{beforeDigest} }, sub {
              # add space to 0 so it gets sorted *before* -1, matching the behaviour of amsmath
              AssignValue('MULTIROW_ALIGNMENT_RULE' => { 'default' => 'center', '0' => 'left', '-1' => 'right' });
          });
          push(@{ $$multline{afterDigest} }, sub {
              my ($document, $whatsit) = @_;
              $whatsit->setProperty('MULTIROW_ALIGNMENT_RULE' => LookupValue('MULTIROW_ALIGNMENT_RULE'));
          });
        }

        # reimplement \shoveleft, \shoveright
        sub amsShove {
          my ($shove_dir) = @_;
          my $alignment = LookupValue('Alignment') or return;

          my $attributes = $$alignment{properties}{attributes} or return;
          my $name       = $$attributes{name}                  or return;

          # \shove* do not change alignment outside of multline, multline*, multlined
          if (ToString($name) =~ m/^multline/ && (my $rowalignment = LookupValue('MULTIROW_ALIGNMENT_RULE'))) {
            my $cur_row_num = $alignment->currentRowNumber - 1;
            $$rowalignment{$cur_row_num} = $shove_dir;
          }

          return;
        }

        DefConstructor('\lx@ams@shoveleft{}', '#1', beforeDigest => sub { amsShove('left'); return; }, reversion => '#1');
        DefConstructor('\lx@ams@shoveright{}', '#1', beforeDigest => sub { amsShove('right'); return; }, reversion => '#1');

        Let('\shoveleft',  '\lx@ams@shoveleft');
        Let('\shoveright', '\lx@ams@shoveright');

        if (LookupValue('mathtools.sty.ltxml_loaded')) {
          DefMacro('\shoveleft[]{}', sub {
              my ($gullet, $dim, $eqn) = @_;
              $dim = readExpression($gullet, 'dimen', $dim) if defined $dim;
              return (T_CS('\lx@ams@shoveleft'), T_BEGIN, ($dim ? (T_CS('\kern'), Tokenize($dim->toString)) : ()), $eqn, T_END);
          });

          DefMacro('\shoveright[]{}', sub {
              my ($gullet, $dim, $eqn) = @_;
              $dim = readExpression($gullet, 'dimen', $dim) if defined $dim;
              return (T_CS('\lx@ams@shoveright'), T_BEGIN, $eqn, ($dim ? (T_CS('\kern'), Tokenize($dim->toString)) : ()), T_END);
          });
        }
      }

      return;
  });
}

InputDefinitions('bookml/bookml.sty', noltxml => 1);

1;
