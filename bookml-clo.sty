\def\bml@clo@options@aastex{
  \DeclareOption{10pt}{\def\aas@ptsize{0}}
  \DeclareOption{11pt}{\def\aas@ptsize{1}}
  \DeclareOption{12pt}{\def\aas@ptsize{2}}

  \DeclareOption{manuscript}{\def\aas@ptsize@forced{2}}
  \DeclareOption{aasms4}{\def\aas@ptsize@forced{2}}

  \DeclareOption{preprint}{\def\@ptsize@maybe{1}}
  \DeclareOption{aaspp4}{\def\@ptsize@maybe{1}}
  \DeclareOption{aj_pt4}{\def\@ptsize@maybe{1}}
  \DeclareOption{apjpt4}{\def\@ptsize@maybe{1}}

  \DeclareOption{preprint2}{\def\@ptsize@maybe{0}}
  \DeclareOption{aas2pp4}{\def\@ptsize@maybe{0}}

  \ExecuteOptions{manuscript}

  \def\bml@clo@apply{
    \ifcsname aas@ptsize@forced\endcsname
      \let\aas@ptsize\aas@ptsize@forced
    \else
      \ifcsname aas@ptsize\endcsname
      \else
        \let\aas@ptsize\aas@ptsize@maybe
      \fi
    \fi
    \input{size1\aas@ptsize.clo}
  }
}

\def\bml@clo@options@acmart{
  \bml@clo@amscls

  \DeclareOption{8pt}{\def\ACM@fontsize@explicit{8}}
  \DeclareOption{9pt}{\def\ACM@fontsize@explicit{9}}
  \DeclareOption{10pt}{\def\ACM@fontsize@explicit{10}}
  \DeclareOption{11pt}{\def\ACM@fontsize@explicit{11}}
  \DeclareOption{12pt}{\def\ACM@fontsize@explicit{12}}

  \DeclareOption{manuscript}{\def\ACM@fontsize@format{9}}
  \DeclareOption{acmsmall}{\def\ACM@fontsize@format{10}}
  \DeclareOption{acmlarge}{\def\ACM@fontsize@format{10}}
  \DeclareOption{acmtog}{\def\ACM@fontsize@format{9}}
  \DeclareOption{sigconf}{\def\ACM@fontsize@format{9}}
  \DeclareOption{siggraph}{\def\ACM@fontsize@format{9}}
  \DeclareOption{sigplan}{\def\ACM@fontsize@format{10}}
  \DeclareOption{sigchi}{\def\ACM@fontsize@format{9}}
  \DeclareOption{sigchi-a}{\def\ACM@fontsize@format{10}}
  \DeclareOption{acmengage}{\def\ACM@fontsize@format{10}}
  \DeclareOption{acmp}{\def\ACM@fontsize@format{9}}

  \def\bml@clo@apply{
    \ifcsname ACM@fontsize@explicit\endcsname
      \let\ACM@fontsize\ACM@fontsize@explicit
    \else
      \let\ACM@fontsize\ACM@fontsize@format
    \fi
    \ifcase\ACF@fontsize
      \or\or\or\or\or\or\or
      \or\bml@clo@amscls@viiipt
      \or\bml@clo@amscls@ixpt
      \or\bml@clo@amscls@xpt
      \or\bml@clo@amscls@xipt
      \or\bml@clo@amscls@xiipt
    \fi
    \edef\ACF@fontsize{\ACF@fontsize pt}
    \ClassInfo{acmart}{Using fontsize \ACM@fontsize}
  }
}

\def\bml@clo@amscls{
  \def\@adjustvertspacing{%
    \bigskipamount.7\baselineskip plus.7\baselineskip
    \medskipamount\bigskipamount \divide\medskipamount\tw@
    \smallskipamount\medskipamount \divide\smallskipamount\tw@
    \abovedisplayskip\medskipamount
    \belowdisplayskip \abovedisplayskip
    \abovedisplayshortskip\abovedisplayskip
    \advance\abovedisplayshortskip-1\abovedisplayskip
    \belowdisplayshortskip\abovedisplayshortskip
    \advance\belowdisplayshortskip 1\smallskipamount
    \jot\baselineskip \divide\jot 4 \relax
  }
  \renewcommand\normalsize{\@xsetfontsize\normalsize 6%
    \@adjustvertspacing \let\@listi\@listI}
  \DeclareRobustCommand{\Tiny}{\@xsetfontsize\Tiny 1}
  \DeclareRobustCommand{\tiny}{\@xsetfontsize\tiny 2}
  \DeclareRobustCommand{\SMALL}{\@xsetfontsize\SMALL 3}
  \DeclareRobustCommand{\Small}{\@xsetfontsize\Small 4%
    \@adjustvertspacing
    \def\@listi{\topsep\smallskipamount \parsep\z@skip \itemsep\z@skip
      \leftmargin=\leftmargini
      \labelwidth=\leftmargini \advance\labelwidth-\labelsep
    }%
  }
  \DeclareRobustCommand{\small}{\@xsetfontsize\small 5\@adjustvertspacing}
  \def\footnotesize{\Small}
  \def\scriptsize{\SMALL}
  \DeclareRobustCommand{\large}{\@xsetfontsize\large 7\@adjustvertspacing}
  \DeclareRobustCommand{\Large}{\@xsetfontsize\Large 8\@adjustvertspacing}
  \DeclareRobustCommand{\LARGE}{\@xsetfontsize\LARGE 9}
  \DeclareRobustCommand{\huge}{\@xsetfontsize\huge{10}}
  \DeclareRobustCommand{\Huge}{\@xsetfontsize\Huge{11}}
  \def\@xsetfontsize#1#2{%
    \chardef\@currsizeindex#2\relax
    \edef\@tempa{\@nx\@setfontsize\@nx#1%
      \@xp\ifcase\@xp\@currsizeindex\@typesizes
        \else{99}{99}\fi}%
    \@tempa
  }

  \def\bml@clo@amscls@xpt{\def\@mainsize{10}\def\@ptsize{0}%
    \def\@typesizes{%
      \or{5}{6}\or{6}{7}\or{7}{8}\or{8}{10}\or{9}{11}%
      \or{10}{12}% normalsize
      \or{\@xipt}{13}\or{\@xiipt}{14}\or{\@xivpt}{17}%
      \or{\@xviipt}{20}\or{\@xxpt}{24}}%
    \normalsize \linespacing=\baselineskip}
  \def\bml@clo@amscls@xipt{\def\@mainsize{11}\def\@ptsize{1}%
    \def\@typesizes{%
      \or{6}{7}\or{7}{8}\or{8}{10}\or{9}{11}\or{10}{12}%
      \or{\@xipt}{13}% normalsize
      \or{\@xiipt}{14}\or{\@xivpt}{17}\or{\@xviipt}{20}%
      \or{\@xxpt}{24}\or{\@xxvpt}{30}}%
    \normalsize \linespacing=\baselineskip
  }
  \def\bml@clo@amscls@xiipt{\def\@mainsize{12}\def\@ptsize{2}%
    \def\@typesizes{%
      \or{7}{8}\or{8}{10}\or{9}{11}\or{10}{12}\or{\@xipt}{13}%
      \or{\@xiipt}{14}% normalsize
      \or{\@xivpt}{17}\or{\@xviipt}{20}\or{\@xxpt}{24}%
      \or{\@xxvpt}{30}\or{\@xxvpt}{30}}%
    \normalsize \linespacing=\baselineskip
  }
  \def\bml@clo@amscls@viiipt{\def\@mainsize{8}\def\@ptsize{8}%
    \def\@typesizes{%
      \or{5}{6}\or{5}{6}\or{5}{6}\or{6}{7}\or{7}{8}%
      \or{8}{10}% normalsize
      \or{9}{11}\or{10}{12}\or{\@xipt}{13}%
      \or{\@xiipt}{14}\or{\@xivpt}{17}}%
    \normalsize \linespacing=\baselineskip
  }
  \def\bml@clo@amscls@ixpt{\def\@mainsize{9}\def\@ptsize{9}%
    \def\@typesizes{%
      \or{5}{6}\or{5}{6}\or{6}{7}\or{7}{8}\or{8}{10}%
      \or{9}{11}% normalsize
      \or{10}{12}\or{\@xipt}{13}\or{\@xiipt}{14}%
      \or{\@xivpt}{17}\or{\@xviipt}{20}}%
    \normalsize \linespacing=\baselineskip
  }
}

