\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{bookml/bookml-init}[@DATE@ @VERSION@ BookML: bookdown flavoured GitBook port for LaTeXML (init package)]

\ifcsname if@bookml\endcsname\else
  \expandafter\newif\csname if@bookml\endcsname
\fi

\if@bookml

\RequirePackage{etoolbox}

% import raw font handling from latex.ltx
\def\baselinestretch{1}

\def\@setfontsize#1#2#3{\@nomath#1%
    \ifx\protect\@typeset@protect
      \let\@currsize#1%
    \fi
    \fontsize{#2}{#3}\selectfont}
\def\@setsize#1#2#3#4{\@setfontsize#1{#4}{#2}}

\DeclareRobustCommand\linespread[1]
   {\set@fontsize{#1}\f@size\f@baselineskip}
\DeclareRobustCommand\fontsize[2]
   {\set@fontsize\baselinestretch{#1}{#2}}

\def\set@fontsize#1#2#3{%
    \@defaultunits\@tempdimb#2pt\relax\@nnil
    \edef\f@size{\strip@pt\@tempdimb}%
    \@defaultunits\@tempskipa#3pt\relax\@nnil
    \edef\f@baselineskip{\the\@tempskipa}%
    \edef\f@linespread{#1}%
    \let\baselinestretch\f@linespread
      \def\size@update{%
        \baselineskip\f@baselineskip\relax
        \baselineskip\f@linespread\baselineskip
        \normalbaselineskip\baselineskip
        \setbox\strutbox\hbox{%
          \vrule\@height.7\baselineskip
                \@depth.3\baselineskip
                \@width\z@}%
        \let\size@update\relax}%
  }

% handle package options immediately after \documentclass
\bml@at@afterdigest\documentclass{\edef\bml@class@name{#2}\bml@init@schema\usepackage{bookml/bookml-clo}}

\ifx\@classoptionslist\relax\else
\PackageWarning{bookml/bookml-init}{add \RequirePackage{bookml/bookml-init} before \documentclass for best results}
\bml@init@schema\usepackage{bookml/bookml-clo}
\fi

% just in case we failed to detect that \documentclass was already called
\AtEndPreamble{\bml@init@schema\usepackage{bookml/bookml-clo}\usepackage{bookml/bookml}}

\fi
