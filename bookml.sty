%%% HTML

% mimic how hyperref parses URLs with the following additions:
% - preserve newlines
% - expand \textbackslash to '\'
% - expand \{, \} to '{', '}'
\def\bml@html@beginvrb{%
  \begingroup%
  \catcode`\^^M=12%
  \catcode`\%=12%
  \catcode`\#=12%
  \catcode`\_=12%
  \catcode`\$=12%
  \catcode`\&=12%
  \edef\{{\expandafter\@gobble\string\{}%
  \edef\}{\expandafter\@gobble\string\}}%
  \let\%\@percentchar%
  \edef\#{\string##}%
  \edef\&{\string&}%
  \edef\textunderscore{\string_}%
  \let\_\textunderscore%
  \edef\textasciitilde{\string~}%
  \let\~\textasciitilde%
  \let~\textasciitilde%
  \let\\\@backslashchar%
  \let\textbackslash\@backslashchar%
  \obeyspaces\obeylines}
\let\bml@html@endvrb\endgroup

%%% Inline HTML tags via environments
% \begin{h:TAG}[attr1=value,attr2] ... \end{h:TAG}
\iflatexml
  \def\bml@html@env#1#2{%
    \bml@html@setinline{#1}{#2}%
    \ifcsname h:#1\endcsname\else%
      \newenvironment{h:#1}%
        {\begin{bml@html@env@}{#1}%
          \@ifnextchar[{\bml@html@beginvrb\bml@html@attrs}{}}%
        {\end{bml@html@env@}}%
    \fi}
  \def\bml@html@attrs[#1]{%
    \edef\@tempa{#1}%
    \expandafter\bml@html@attrs@\@tempa,\relax,\bml@html@endvrb}
  % parse attributes exactly like keyval.sty
  \def\bml@html@attrs@#1,{%
    \ifx\relax#1\@empty\else%
      \bml@html@attr#1==\relax%
      \expandafter\bml@html@attrs@\fi}
  \def\bml@html@attr#1=#2=#3\relax{\bml@html@attr@{#1}{#2}}
\else
  \def\bml@html@env#1#2{\newenvironment{h:#1}[1][]{}{}}
\fi
\def\bmlHTMLEnvironment#1{\@for\name:=#1\do{\expandafter\bml@html@env\expandafter{\name}{}}}
\def\bmlHTMLInlineEnvironment#1{\@for\name:=#1\do{\expandafter\bml@html@env\expandafter{\name}{inline}}}

% grossly simplified HTML model based on whether a tag admits flow content and
% is not 'transparent'
% - tags with flow content, and not transparent, emit a block-like element
% - otherwise they emit an inline-like element
% list based on HTML living standard, index of elements
\bmlHTMLEnvironment{address,area,article,aside,base,blockquote,body,caption,col,colgroup,dd,details,dialog,div,dl,dt,fieldset,figcaption,figure,footer,form,h1,h2,h3,h4,h5,h6,head,header,hgroup,hr,html,legend,li,link,main,menu,meta,nav,ol,optgroup,option,p,pre,search,section,selectedcontent,source,style,table,tbody,td,tfoot,th,thead,title,tr,track,ul}
\bmlHTMLInlineEnvironment{a,abbr,acronym,audio,b,bdi,bdo,big,br,button,
canvas,cite,code,data,datalist,del,dfn,em,embed,i,iframe,img,
input,ins,kbd,label,map,mark,math,meter,noscript,object,output,
picture,progress,q,rp,rt,ruby,s,samp,script,select,slot,small,span,
strong,sub,summary,sup,svg,template,textarea,time,u,tt,var,video,wbr}

%%% Inline HTML tags via \<
% \<tag attr1="value" attr>
\ifbml@htmlsyntax
  \iflatexml
    \def\<{%
      \bml@html@beginvrb%
      \long\def\<#1>{%
        \edef\@tempa{#1}%
        \expandafter\bml@html@tag\expandafter{\@tempa}\bml@html@endvrb}%
      \<}
  \else
    \long\def\<#1>{}
  \fi
\fi

%%% Inline HTML via \bmlRawHTML
\iflatexml
  \long\def\bmlRawHTML{%
    \bml@html@beginvrb%
    \bml@html@raw}
  \def\bml@html@raw#1{%
    \edef\@tempa{#1}%
    \expandafter\bml@html@raw@\expandafter{\@tempa}\bml@html@endvrb}
\else
  \long\def\bmlRawHTML#1{}
\fi

%%% Image generation via LaTeX
% \begin{bmlimage} ... \end{bmlimage}
% \bmlImageEnvironment{tikzipicture}
\iflatexml
  \RequirePackage{graphicx}
  \newcounter{bml@image@counter}

  \def\bmlImageEnvironment#1{%
    \@for\@tempa:=#1\do{\expandafter\bml@image@env\expandafter{\@tempa}}}
  \def\bml@image@env#1{%
    \AtBeginDocument{\bml@image@env@{#1}}}
  \def\bml@image@env@#1{
    \expandafter\def\csname begin{#1}\endcsname{%
      \bml@image@env@replace{#1}}}

  \def\bml@image@env@replace#1{%
    \edef\bml@image@env@name{#1}%
    \bml@image@env@findend}
  \def\bml@image@env@findend#1\end{%
    \bml@image@env@maybeclose}
  \def\bml@image@env@maybeclose#1{%
    \def\@tempa{#1}%
    \ifx\@tempa\bml@image@env@name\bml@image@include%
    \else\expandafter\bml@image@env@findend\fi}
  \ifbml@draft
    \def\bml@image@include{\stepcounter{bml@image@counter}%
      \texttt{bmlimages/\jobname-\thebml@image@counter.svg}}
  \else
    \def\bml@image@include{%
      \bml@image@generate%
      \global\let\bml@image@generate\relax%
      \stepcounter{bml@image@counter}%
      \includegraphics{bmlimages/\jobname-\thebml@image@counter.svg}%
      \bml@image@depth{\thebml@image@counter}}
  \fi
\else
  \ifbml@images
    \RequirePackage[noconfig,delayed,active,tightpage]{preview}
    \def\bmlImageEnvironment#1{%
      \@for\@tempa:=#1\do{\PreviewEnvironment{\@tempa}}}
  \else
    \let\bmlImageEnvironment\@gobble
  \fi
\fi

\newenvironment{bmlimage}{}{}
\bmlImageEnvironment{preview,bmlimage}

