  \edef\@tempa{\CurrentOption}
  \def\bml@image@checkscale imagescale=#1\relax{
    \def\@tempa{#1}
    \ifx\@tempa\@empty
    \else
      \PackageWarning{bookml}{the option imagescale is deprecated and may be ignored in future releases}
      \bml@image@savescale#1\relax
    \fi
  }
  \def\bml@image@savescale #1imagescale=\relax{
    \def\bml@image@scale{#1}
  }
  \expandafter\bml@image@checkscale\@tempa imagescale=\relax
}

