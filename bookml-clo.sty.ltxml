package LaTeXML::Package::Pool;
use strict;
use warnings;

my $class = LookupDefinition(T_CS('\bml@class@name')) ? ToString(Expand(T_CS('\bml@class@name'))) : '';

my @classes = ('extarticle', 'extbook', 'extletter', 'extproc', 'extreport', 'a0poster', 'aastex', 'acmart', 'beamer', 'elsart', 'IEEEtran', 'iopart', 'JHEP', 'JHEP2', 'JHEP3', 'minimal', 'slides', 'amsart', 'amsbook', 'amsproc', 'article', 'report', 'book');

if (! grep { $_ eq $class } @classes) {
  $class = '';
  for my $cls (@classes) {
    if (LookupValue("$cls.cls.ltxml_loaded")) {
      $class = $cls; last; } }
  DefMacroI('\bml@class@name', undef, $class); }

InputDefinitions('bookml/bookml-clo.sty', noltxml => 1);

AssignValue('NOMINAL_FONT_SIZE', ToString(Expand(T_CS('\f@size'))), global => 1);

RelaxNGSchema("bookml/schema");

1;