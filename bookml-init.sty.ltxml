package LaTeXML::Package::Pool;
use strict;
use warnings;

DefConditional('\if@bookml', sub { 1; });

PushValue(SEARCHPATHS => pathname_absolute(pathname_canonical("bookml/bindings/v$LaTeXML::VERSION-perl")));

# add commands to be digested in afterDigest
# the body can refer to the arguments via #1, #2, ...
DefPrimitive('\bml@at@afterdigest Token Undigested', sub {
  my ($stomach, $cs, $body) = @_;
  my $defn = LookupDefinition($cs);
  push(@{ $$defn{afterDigest} }, sub {
    my ($stomach, $whatsit) = @_;
    my @args = $whatsit->getArgs;
    DefMacroI('\bml@after@digest@tmp', '{}' x @args, ToString($body));
    $stomach->digest(Invocation(T_CS('\bml@after@digest@tmp'), map { $_ ? Tokens($_->revert) : $_ } @args));
  });
  return;
});

my $selectfont = LookupDefinition(T_CS('\selectfont'));
push(@{ $$selectfont{afterDigest} }, sub {
  my ($stomach) = @_;
  my $size = ToString(Expand(T_CS('\f@size')));
  MergeFont(size => $size);
  $stomach->digest(T_CS('\size@update'));
});

Let(T_CS('\LaTeXMLgenerator'), T_CS('\LaTeXML'));
AtBeginDocument('\lx@save@parameter{bml-generator}{latexml}');
AtBeginDocument('\lx@save@parameter{bml-generator-version}{\LaTeXMLversion}');

DefPrimitive('\bml@init@schema', sub { RelaxNGSchema('bookml/schema'); });

# LaTeXML leaves \@classoptionslist even after \documentclass
if (grep { m/\.cls\.ltxml_loaded|\.cls_loaded$/ } keys %{ $STATE->{value} }) {
  DefMacro('\@classoptionslist','') if XEquals(T_CS('\@classoptionslist'),T_CS('\relax'));
}

DefMacro('\bml@generator@engine', 'perl');

InputDefinitions('bookml/bookml-init.sty', noltxml => 1);

1;
